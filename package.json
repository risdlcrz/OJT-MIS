{
  "name": "ojt-mis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:web": "vite",
    "dev:api": "dotnet run --project ./OJTMISApi/OJTMISApi.csproj",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./stop.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src pages vite.config.js eslint.config.js",
    "test": "dotnet test ./OJTMISApi.Tests/OJTMISApi.Tests.csproj",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.4.0",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
